#!/bin/sh
':' //; export PATH="$HOME/.cache/lm-studio/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; if ! command -v node >/dev/null 2>&1 && [ -d "$HOME/.nvm/versions/node" ]; then NVM_BIN="$(ls -1d "$HOME/.nvm/versions/node/"*/bin 2>/dev/null | /usr/bin/sort -V | tail -n 1)"; [ -n "$NVM_BIN" ] && export PATH="$NVM_BIN:$PATH"; fi; exec node "$0" "$@"

import { execFile } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import process from 'node:process';
import { promisify } from 'node:util';

const execFileAsync = promisify(execFile);

const MODEL_ID = 'humanizer-12b-optiq';
const MODEL_CONTEXT_LENGTH = '8192';
const MODEL_TTL_SECONDS = 900;
const BASE_URL = (process.env.LM_STUDIO_BASE_URL || 'http://127.0.0.1:1234').replace(/\/+$/u, '');

const PROMPT_INSTRUCTION = [
  'Rewrite the text below so it reads like a person wrote it, not a language model.',
  '',
  'Reorganize it as you see fit. Vary sentence length on purpose. Cut hedging,',
  'throat-clearing, and any sentence that only announces what comes next.',
  'Prefer the concrete word over the abstract one. It is fine to sound uneven.',
  '',
  'Every fact, number, unit, date, name and quotation must survive unchanged.',
].join('\n');

await main();

async function main() {
  try {
    const options = parseArgs(process.argv.slice(2));
    if (options.help) {
      printUsage(process.stdout);
      return;
    }

    const rawDraft = readInputDraft(options);
    const draft = rawDraft.replace(/\r\n?/gu, '\n').trim();
    if (!draft) {
      printUsage(process.stderr);
      process.exitCode = 1;
      return;
    }

    await ensureModelLoaded();
    const rewritten = await rewriteDraft(draft);
    process.stdout.write(`${rewritten}\n`);
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    process.stderr.write(`humanize error: ${message}\n`);
    process.exitCode = 1;
  }
}

function parseArgs(args) {
  const positional = [];
  let filePath = null;
  let help = false;

  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === '--') {
      positional.push(...args.slice(index + 1));
      break;
    }

    if (arg === '-h' || arg === '--help') {
      help = true;
      continue;
    }

    if (arg === '-f' || arg === '--file') {
      const nextArg = args[index + 1];
      if (!nextArg) {
        throw new Error('Missing file path after --file');
      }
      if (filePath !== null) {
        throw new Error('Multiple --file options are not supported');
      }
      filePath = nextArg;
      index += 1;
      continue;
    }

    if (arg.startsWith('--file=')) {
      if (filePath !== null) {
        throw new Error('Multiple --file options are not supported');
      }
      filePath = arg.slice('--file='.length);
      if (!filePath) {
        throw new Error('Missing file path after --file=');
      }
      continue;
    }

    if (arg.startsWith('-')) {
      throw new Error(`Unknown option: ${arg}`);
    }

    positional.push(arg);
  }

  if (filePath && positional.length > 0) {
    throw new Error('Cannot combine --file with inline text arguments');
  }

  return {
    filePath,
    help,
    text: positional.join(' '),
  };
}

function readInputDraft(options) {
  if (options.filePath === '-') {
    return fs.readFileSync(0, 'utf8');
  }

  if (options.filePath) {
    return fs.readFileSync(options.filePath, 'utf8');
  }

  if (options.text) {
    return options.text;
  }

  if (!process.stdin.isTTY) {
    return fs.readFileSync(0, 'utf8');
  }

  return '';
}

function resolveLmsBinary() {
  const defaultPath = path.join(os.homedir(), '.cache', 'lm-studio', 'bin', 'lms');
  if (fs.existsSync(defaultPath)) {
    return defaultPath;
  }

  return 'lms';
}

async function fetchModelState() {
  try {
    const response = await fetch(`${BASE_URL}/api/v0/models`, {
      signal: AbortSignal.timeout(5000),
    });
    if (!response.ok) {
      return {
        loaded: false,
        serverReachable: false,
      };
    }

    const payload = await response.json();
    const models = Array.isArray(payload?.data) ? payload.data : [];
    const loaded = models.some(function isHumanizerLoaded(entry) {
      return (
        typeof entry?.id === 'string' &&
        (entry.id === MODEL_ID || entry.id.startsWith(`${MODEL_ID}:`)) &&
        entry.state === 'loaded'
      );
    });

    return {
      loaded,
      serverReachable: true,
    };
  } catch {
    return {
      loaded: false,
      serverReachable: false,
    };
  }
}

async function ensureModelLoaded() {
  const lmsBin = resolveLmsBinary();
  let status = await fetchModelState();

  if (!status.serverReachable) {
    process.stderr.write('Starting LM Studio server...\n');
    await execFileAsync(lmsBin, ['server', 'start']);
    status = await fetchModelState();
    if (!status.serverReachable) {
      throw new Error(`LM Studio server is not reachable at ${BASE_URL}`);
    }
  }

  if (status.loaded) {
    return;
  }

  process.stderr.write(`Loading ${MODEL_ID} in LM Studio...\n`);
  try {
    await execFileAsync(lmsBin, [
      'load',
      MODEL_ID,
      '--identifier',
      MODEL_ID,
      '--context-length',
      MODEL_CONTEXT_LENGTH,
      '--ttl',
      String(MODEL_TTL_SECONDS),
      '--yes',
    ]);
  } catch (error) {
    const refreshed = await fetchModelState();
    if (!refreshed.loaded) {
      throw error;
    }
  }
}

async function rewriteDraft(draft) {
  const prompt = `${PROMPT_INSTRUCTION}\n\n${draft}\n\n### Rewritten:\n\n`;
  const response = await fetch(`${BASE_URL}/v1/completions`, {
    body: JSON.stringify({
      model: MODEL_ID,
      prompt,
      stop: ['### Rewritten'],
      ttl: MODEL_TTL_SECONDS,
    }),
    headers: {
      'Content-Type': 'application/json',
    },
    method: 'POST',
  });

  if (!response.ok) {
    const errorText = await response.text();
    throw new Error(`LM Studio completion failed (${response.status}): ${errorText}`);
  }

  const payload = await response.json();
  const choice = payload?.choices?.[0];
  if (choice?.finish_reason === 'length') {
    throw new Error(
      'Completion truncated at context length limit; split the input into smaller sections',
    );
  }

  const rewritten = choice?.text;
  if (typeof rewritten !== 'string' || !rewritten.trim()) {
    throw new Error('LM Studio returned an empty completion');
  }

  return rewritten.trim();
}

function printUsage(stream) {
  stream.write(
    [
      'Usage: humanize [options] [text]',
      '',
      'Rewrite AI-sounding text into human-sounding text using LM Studio (humanizer-12b-optiq).',
      '',
      'Input modes:',
      '  humanize <<\'EOF\' ... EOF     Read draft text from stdin (recommended for multiline text)',
      '  humanize --file <path>       Read draft text from a file',
      '  humanize "draft text"        Pass short draft text as an argument',
      '',
      'Options:',
      '  -f, --file <path>            Read input text from file',
      '  -h, --help                   Show this help message',
      '',
    ].join('\n'),
  );
}
